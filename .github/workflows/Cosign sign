name: Build, push, and sign container image (Cosign)

on:
  push:
    branches: [ main ]
  release:
    types: [ published ]

permissions:
  contents: read
  packages: write
  id-token: write   # required for keyless (OIDC) cosign signing

jobs:
  build-and-sign:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up QEMU
        uses: docker/setup-qemu-action@v2

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v2

      - name: Login to registry
        uses: docker/login-action@v2
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build and push image
        uses: docker/build-push-action@v4
        with:
          context: .
          push: true
          tags: ghcr.io/${{ github.repository }}:latest

      - name: Install cosign
        uses: sigstore/cosign-installer@v1

      - name: Sign image (keyless, OIDC)
        env:
          COSIGN_EXPERIMENTAL: "1"   # older cosign versions required this for keyless; harmless if not needed
        run: |
          IMAGE=ghcr.io/${{ github.repository }}:latest
          # Keyless signing uses GitHub Actions OIDC. No long-lived private key required.
          cosign sign --keyless "$IMAGE"

      # ----- Optional: keyed signing (if you prefer to use a key) -----
      - name: Sign image (using private key from secret) [optional]
        if: false  # set to true if you prefer using a key instead of keyless OIDC
        env:
          COSIGN_PASSWORD: ${{ secrets.COSIGN_PASSWORD }}
        run: |
          echo "$COSIGN_PRIVATE_KEY" > cosign.key
          chmod 600 cosign.key
          IMAGE=ghcr.io/${{ github.repository }}:latest
          cosign sign --key cosign.key "$IMAGE"
          shred -u cosign.key
        # Note: store private key value in secret COSIGN_PRIVATE_KEY (PEM) and COSIGN_PASSWORD if encrypted
