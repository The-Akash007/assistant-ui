name: 'CodeQL Security Analysis'

on:
  push:
    branches:
      - main
      - develop
  pull_request:
    branches:
      - main
      - develop
  schedule:
    # Weekly security scan on Monday at 2 AM UTC
    - cron: '0 2 * * 1'

jobs:
  analyze:
    name: Analyze JavaScript/TypeScript Code
    runs-on: ubuntu-latest
    permissions:
      actions: read
      contents: read
      security-events: write

    strategy:
      fail-fast: false
      matrix:
        language:
          - javascript-typescript

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Initialize CodeQL
        uses: github/codeql-action/init@v3
        with:
          languages: ${{ matrix.language }}
          # Enable security queries for multiple vulnerability types
          queries: security-and-quality
          # Setup database for comprehensive analysis
          db-location: '${{ runner.temp }}/codeql_databases'

      - name: Autobuild
        uses: github/codeql-action/autobuild@v3

      - name: Perform CodeQL Analysis
        uses: github/codeql-action/analyze@v3
        with:
          category: '/language:${{ matrix.language }}'
          upload: true

      - name: Upload SARIF to GitHub Security
        uses: github/codeql-action/upload-sarif@v3
        if: success() || failure()
        with:
          sarif_file: '${{ runner.temp }}/codeql_databases'
          category: 'CodeQL Security Scan'
          wait-for-processing: true

  security-checks:
    name: Run Security Queries
    runs-on: ubuntu-latest
    permissions:
      actions: read
      contents: read
      security-events: write
    needs: analyze

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Initialize CodeQL for Extended Analysis
        uses: github/codeql-action/init@v3
        with:
          languages: javascript-typescript
          # Focus on security-related queries
          queries: |
            security-extended
          db-location: '${{ runner.temp }}/codeql_databases'

      - name: Autobuild
        uses: github/codeql-action/autobuild@v3

      - name: Analyze for Common Vulnerabilities
        uses: github/codeql-action/analyze@v3
        with:
          category: '/language:javascript-typescript-security'
          upload: true

  codeql-sarif-upload:
    name: Upload CodeQL Results
    runs-on: ubuntu-latest
    permissions:
      security-events: write
    needs: [analyze, security-checks]
    if: always()

    steps:
      - name: Download SARIF files
        uses: actions/download-artifact@v4
        with:
          path: sarif-results

      - name: Upload to GitHub Security tab
        uses: github/codeql-action/upload-sarif@v3
        with:
          sarif_file: sarif-results
          wait-for-processing: true
        continue-on-error: true
