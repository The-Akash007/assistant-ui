name: SBOM + Semgrep CI

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]
  workflow_dispatch: {}

jobs:
  sbom:
    name: Generate SBOMs (Syft)
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Install Syft
        run: |
          # install latest syft to /usr/local/bin
          curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | sh -s -- -b /usr/local/bin

      - name: Generate SBOM (SPDX JSON)
        run: syft . -o spdx-json=sbom.spdx.json

      - name: Generate SBOM (CycloneDX JSON)
        run: syft . -o cyclonedx=sbom.cdx.json

      - name: Upload SBOM artifacts
        uses: actions/upload-artifact@v4
        with:
          name: sbom
          path: |
            sbom.spdx.json
            sbom.cdx.json

  semgrep:
    name: Semgrep Fast SAST
    needs: sbom
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Run Semgrep (official action)
        uses: returntocorp/semgrep-action@v2
        with:
          # Change this if you prefer .semgrep.yml or registry rules (eg: p/ci)
          config: .semgrep-rules/
          github_token: ${{ secrets.GITHUB_TOKEN }}
          # Optional: write SARIF output so results show up in GitHub code scanning
          format: sarif
          output-file: semgrep-results.sarif

      - name: Upload Semgrep JSON results as artifact
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: semgrep-results-json
          path: semgrep-results.json

      - name: Upload SARIF to GitHub code scanning (if present)
        if: always()
        uses: github/codeql-action/upload-sarif@v2
        with:
          sarif_file: semgrep-results.sarif
