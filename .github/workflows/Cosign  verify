name: Verify image signature (Cosign) on PR

on:
  pull_request:
    types: [ opened, synchronize, reopened ]

permissions:
  contents: read
  id-token: write

jobs:
  verify-signature:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install cosign
        uses: sigstore/cosign-installer@v1

      - name: Verify image signature (keyless)
        run: |
          IMAGE=ghcr.io/${{ github.repository }}:latest
          # For keyless signatures:
          cosign verify --keyless "$IMAGE"

      # Optional: verify with public key
      - name: Verify image signature (public key) [optional]
        if: false
        run: |
          IMAGE=ghcr.io/${{ github.repository }}:latest
          echo "${{ secrets.COSIGN_PUB_KEY }}" > cosign.pub
          cosign verify --key cosign.pub "$IMAGE"
