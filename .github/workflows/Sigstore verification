name: Sigstore / Cosign verification

on:
  pull_request:
    types: [opened, synchronize, reopened]
  workflow_dispatch:
    inputs:
      image:
        description: 'Container image to verify (e.g. ghcr.io/owner/repo:tag)'
        required: false
        default: ''
      artifact:
        description: 'Path to artifact file to verify (e.g. dist/release.tar.gz)'
        required: false
        default: ''
      signature:
        description: 'Path to signature file for the artifact (e.g. dist/release.tar.gz.sig)'
        required: false
        default: ''

permissions:
  contents: read

jobs:
  verify:
    name: Verify signatures (cosign / sigstore)
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install cosign
        uses: sigstore/cosign-installer@v1

      - name: Determine image and artifact inputs
        id: inputs
        run: |
          # Determine image to verify. Use workflow_dispatch input when provided,
          # otherwise fall back to GHCR repo:latest
          if [ -n "${{ github.event.inputs.image }}" ]; then
            echo "image=${{ github.event.inputs.image }}" >> $GITHUB_OUTPUT
          else
            echo "image=ghcr.io/${{ github.repository }}:latest" >> $GITHUB_OUTPUT
          fi

          # Artifact & signature (optional)
          echo "artifact=${{ github.event.inputs.artifact }}" >> $GITHUB_OUTPUT
          echo "signature=${{ github.event.inputs.signature }}" >> $GITHUB_OUTPUT

      - name: Verify container image (keyless)
        run: |
          IMAGE="${{ steps.inputs.outputs.image }}"
          echo "Verifying image: $IMAGE (keyless)"
          cosign verify --keyless "$IMAGE"
        # If cosign verify fails the job will fail

      - name: Verify container image using public key (optional)
        if: ${{ secrets.COSIGN_PUB_KEY != '' }}
        run: |
          echo "${{ secrets.COSIGN_PUB_KEY }}" > cosign.pub
          chmod 600 cosign.pub
          IMAGE="${{ steps.inputs.outputs.image }}"
          echo "Verifying image: $IMAGE (public key)"
          cosign verify --key cosign.pub "$IMAGE"
          rm -f cosign.pub

      - name: Verify artifact (blob) signature (keyless) [optional]
        if: ${{ steps.inputs.outputs.artifact != '' && steps.inputs.outputs.signature != '' }}
        run: |
          ARTIFACT="${{ steps.inputs.outputs.artifact }}"
          SIG="${{ steps.inputs.outputs.signature }}"
          echo "Verifying artifact signature (keyless): $ARTIFACT with $SIG"
          cosign verify-blob --keyless --signature "$SIG" "$ARTIFACT"

      - name: Verify artifact (blob) with public key (optional)
        if: ${{ steps.inputs.outputs.artifact != '' && steps.inputs.outputs.signature != '' && secrets.COSIGN_PUB_KEY != '' }}
        run: |
          echo "${{ secrets.COSIGN_PUB_KEY }}" > cosign.pub
          chmod 600 cosign.pub
          ARTIFACT="${{ steps.inputs.outputs.artifact }}"
          SIG="${{ steps.inputs.outputs.signature }}"
          echo "Verifying artifact signature (pubkey): $ARTIFACT with $SIG"
          cosign verify-blob --key cosign.pub --signature "$SIG" "$ARTIFACT"
          rm -f cosign.pub

      - name: Upload verification result summary
        if: success() || failure()
        uses: actions/upload-artifact@v4
        with:
          name: sigstore-verify-result
          path: |
            # include any generated logs here if needed
            # none are generated by default; this is a placeholder
